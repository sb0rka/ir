# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DB_INV_SCHEMA_NAME=inv
DB_ADMIN_USER=${POSTGRES_USER}
DB_ADMIN_PASSWORD=${POSTGRES_PASSWORD}

API_PORT=8090
GATEWAY_PORT=8091
LOG_FORMAT=text

AUTH_ISSUER=https://auth.sb0rka.internal
AUTH_ALLOW_INSECURE_HTTP_ISSUER=false
OIDC_CLIENT_ID=sb0rka-ir-web
OIDC_CLIENT_SECRET_FILE_PATH=../sb0rka/.local/auth-client-secrets/ir-web.secret
AUTH_INTROSPECTION_CLIENT_ID=sb0rka-ir-gateway
AUTH_INTROSPECTION_CLIENT_SECRET_FILE_PATH=../sb0rka/.local/auth-client-secrets/ir-gateway.secret
IR_PUBLIC_BASE_URL=https://ir-api.sb0rka.internal
IR_WEB_URL=https://ir.sb0rka.internal
IR_SESSION_ENCRYPTION_KEY_FILE_PATH=.local/auth/ir-session.key
IR_OIDC_CONTEXT_ENCRYPTION_KEY_FILE_PATH=.local/auth/ir-oidc-context.key
SB0RKA_API_BASE_URL=https://api.sb0rka.internal
GATEWAY_BASE_URL=https://ir-gateway.sb0rka.internal
SERVER_CORS_WHITELIST=http://localhost:5174
PROJECT_SOURCE_ALLOWLISTS={}


# External integrations via OpenVPN
OPENVPN_CONFIG_FILE=external.ovpn
SOURCE_PT_MAXPATROL_SIEM_BASE_URL=https://siem.local
SOURCE_PT_MAXPATROL_SIEM_INCIDENTS_BASE_URL=https://siem.local
SOURCE_PT_NAD_BASE_URL=https://nad.local
SOURCE_PT_NAD_STORE_IDS=19,26
GATEWAY_SKIP_TLS_VERIFY=true
PT_NAD_HOST_IP=10.10.10.10
PT_SIEM_HOST_IP=10.10.10.11
