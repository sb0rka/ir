# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DB_INV_SCHEMA_NAME=inv
DB_ADMIN_USER=${POSTGRES_USER}
DB_ADMIN_PASSWORD=${POSTGRES_PASSWORD}

API_PORT=8090
GATEWAY_PORT=8091
SERVER_CORS_WHITELIST=http://localhost:5173,http://localhost:4173,http://localhost:3000
LOG_FORMAT=text

# Sb0rka integration
SB0RKA_API_BASE_URL=http://api:8080
SB0RKA_AUTH_BASE_URL=http://host.docker.internal:8020
ACCESS_TOKEN_PRIVATE_KEY=BASE64_PKCS8_PEM
ACCESS_TOKEN_ISSUER=auth.local
ACCESS_TOKEN_AUDIENCE=api.local
ACCESS_TOKEN_KID=ed25519-v1
ACCESS_TOKEN_TYP=access+jwt

PROJECT_SOURCE_ALLOWLISTS={"123123123":["pt-maxpatrol-siem","pt-nad"]}

# SOM integration
SOM_API_BASE_URL=https://api.som.local
SOM_RELAY_BASE_URL=https://relay.som.local
SOM_HOST_ID=
SOM_REPO_ID=
SOM_REPO_PARENT_PATH=/tmp
SOM_REPO_FOLDER_NAME=ir-demo
SOM_TARGET_BRANCH=main
SOM_EXECUTOR=OPENCODE

IR_PUBLIC_BASE_URL=http://localhost:8090
# Только для локального стенда. В production IR_PUBLIC_BASE_URL обязан быть HTTPS.
MCP_ALLOW_INSECURE_HTTP=true

# External integrations via OpenVPN
OPENVPN_CONFIG_FILE=external.ovpn
SOURCE_PT_MAXPATROL_SIEM_BASE_URL=https://siem.local
SOURCE_PT_MAXPATROL_SIEM_INCIDENTS_BASE_URL=https://siem.local
SOURCE_PT_NAD_BASE_URL=https://nad.local
SOURCE_PT_NAD_STORE_IDS=19,26
GATEWAY_SKIP_TLS_VERIFY=true
PT_NAD_HOST_IP=10.10.10.10
PT_SIEM_HOST_IP=10.10.10.11
