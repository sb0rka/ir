# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DB_INV_SCHEMA_NAME=inv
DB_ADMIN_USER=${POSTGRES_USER}
DB_ADMIN_PASSWORD=${POSTGRES_PASSWORD}

API_PORT=8090
GATEWAY_PORT=8091
SERVER_CORS_WHITELIST=http://localhost:5173,http://localhost:3000
LOG_FORMAT=text
IR_AUTH_DISABLED=true

# SOM integration
SOM_API_BASE_URL=https://api.som.local
SOM_RELAY_BASE_URL=https://relay.som.local
SOM_HOST_ID=
SOM_REPO_ID=
SOM_REPO_PARENT_PATH=/tmp
SOM_REPO_FOLDER_NAME=ir-demo
SOM_TARGET_BRANCH=main
SOM_EXECUTOR=OPENCODE

IR_PUBLIC_BASE_URL=http://host.docker.internal:8090
GATEWAY_PUBLIC_BASE_URL=http://host.docker.internal:8091

GATEWAY_MOCK_EVENT_COUNT=50000
GATEWAY_MOCK_ENDPOINT_COUNT=5000
GATEWAY_MOCK_HISTORY_DAYS=90
