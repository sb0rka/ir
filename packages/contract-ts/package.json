{
  "name": "@ir/contract",
  "version": "0.1.0",
  "description": "Типы и клиент Investigations API, сгенерированные из OpenAPI",
  "type": "module",
  "types": "./paths.gen.ts",
  "exports": {
    ".": {
      "types": "./paths.gen.ts",
      "default": "./client.ts"
    },
    "./domains/*": {
      "types": "./domains/*.d.ts"
    }
  },
  "files": [
    "domains",
    "paths.gen.ts",
    "client.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  }
}
