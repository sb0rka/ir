# Server configuration
SERVER_ADDR="0.0.0.0"
SERVER_PORT="8090"
SERVER_CORS_WHITELIST="http://localhost:3400,http://localhost:3300"

# Database configuration
DATABASE_URI="postgres://postgres:postgres@postgres:5432/investigations?search_path=inv"
DATABASE_MAX_CONNS="10"
DATABASE_CONN_MAX_LIFETIME_SEC="30"

# Logger configuration
LOG_LEVEL="info"
LOG_FORMAT="text"

SB0RKA_AUTH_BASE_URL="http://localhost:8020"
SB0RKA_API_BASE_URL="http://localhost:8080"
# Compose service DNS; use http://localhost:8091 when running IR API on the host.
GATEWAY_BASE_URL="http://gateway:8091"
IR_PUBLIC_BASE_URL="http://localhost:8090"
IR_WEB_URL="http://localhost:3400"

MAX_ACCESS_TOKEN_TTL_SEC="600"
ACCESS_TOKEN_CLOCK_SKEW_SEC="30"
OIDC_CLIENT_ID="sb0rka-ir-web"
SB0RKA_IR_WEB_CLIENT_SECRET=""
# base64-encoded 32-byte keys. Generated with: head -c 32 /dev/urandom | base64 -w0
IR_SESSION_ENCRYPTION_KEY=""
# Different base64-encoded 32-byte key. It must not be the same as IR_SESSION_ENCRYPTION_KEY.
IR_OIDC_CONTEXT_ENCRYPTION_KEY=""
# Same independent base64-encoded 32-byte key in IR API and Gateway.
IR_GATEWAY_CONFIGURATION_KEY=""
# An http issuer needs this opt-in.
# AUTH_ALLOW_INSECURE_HTTP_ISSUER="true"
