SERVER_ADDR="0.0.0.0"
SERVER_PORT="8090"
SERVER_CORS_WHITELIST="*"

DATABASE_URI="postgres://postgres:irdev@localhost:55432/investigations?search_path=inv"
DATABASE_MAX_OPEN_CONNS="10"
DATABASE_CONN_MAX_LIFETIME_SEC="30"

LOG_LEVEL="info"
LOG_FORMAT="json"

# Проверка токенов платформы: сервис держит только публичный ключ,
# подписывать ему нечего.
ACCESS_TOKEN_PUBLIC_KEY_FILE_PATH="./keys/access_token_public_key.pem"
# ACCESS_TOKEN_PUBLIC_KEY="BASE64_SPKI"
ACCESS_TOKEN_ISSUER="auth.local"
ACCESS_TOKEN_AUDIENCE="ir.local"
ACCESS_TOKEN_KID="ed25519-v1"
ACCESS_TOKEN_TYP="access+jwt"

# Субъекты с ролью admin в обход role_bindings — иначе первую роль некому выдать.
INV_BOOTSTRAP_ADMIN_SUBJECTS=""
# Роль субъекта без записей в role_bindings. Пусто = запрет.
INV_DEFAULT_ROLE=""

