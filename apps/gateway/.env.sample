SERVER_ADDR="0.0.0.0"
SERVER_PORT="8091"
SERVER_CORS_WHITELIST="http://localhost:5173,http://localhost:4173,http://localhost:3000"
REQUEST_TIMEOUT_SEC="15"
SOURCE_TIMEOUT_SEC="10"

LOG_LEVEL="info"
LOG_FORMAT="text"

AUTH_DISABLED="false"
ACCESS_TOKEN_ISSUER="auth.local"
ACCESS_TOKEN_AUDIENCE="api.local"
ACCESS_TOKEN_KID="ed25519-v1"
ACCESS_TOKEN_TYP="access+jwt"
ACCESS_TOKEN_PRIVATE_KEY_FILE_PATH="./keys/access_token_private_key.pem"
# ACCESS_TOKEN_PRIVATE_KEY="BASE64_PKCS8"
# ACCESS_TOKEN_PUBLIC_KEY_FILE_PATH="./keys/access_token_public_key.pem"
# ACCESS_TOKEN_PUBLIC_KEY="BASE64_SPKI"

PROJECT_SOURCE_ALLOWLISTS='{"abcdef1234":["maxpatrol-siem","pt-sandbox"]}'
SB0RKA_API_BASE_URL="http://api:8080"

MOCK_EVENT_COUNT="50000"
MOCK_ENDPOINT_COUNT="5000"
MOCK_HISTORY_DAYS="90"

# Skip TLS certificate verification for outbound provider calls (lab SIEM with private CA).
GATEWAY_SKIP_TLS_VERIFY="true"

SOURCE_MAXPATROL_SIEM_MODE="mock"
SOURCE_PT_SANDBOX_MODE="mock"
