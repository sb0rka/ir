# Server configuration
SERVER_ADDR="0.0.0.0"
SERVER_PORT="8091"
SERVER_CORS_WHITELIST="http://localhost:3400,http://localhost:3300"
REQUEST_TIMEOUT_SEC="15"
SOURCE_TIMEOUT_SEC="10"
# Required when an event source is enabled. Generate once: openssl rand -base64 32
# Share the same value between Gateway replicas.
GATEWAY_CURSOR_SIGNING_KEY=""

# Logger configuration
LOG_LEVEL="info"
LOG_FORMAT="text"

SB0RKA_AUTH_BASE_URL="http://localhost:8020"
SB0RKA_API_BASE_URL="http://localhost:8080"

DATABASE_URI=""
IR_GATEWAY_CONFIGURATION_KEY=""

MAX_ACCESS_TOKEN_TTL_SEC="600"
ACCESS_TOKEN_CLOCK_SKEW_SEC="30"
AUTH_INTROSPECTION_CLIENT_ID="sb0rka-ir-gateway"
SB0RKA_IR_GATEWAY_CLIENT_SECRET=""
# An http issuer needs this opt-in.
# AUTH_ALLOW_INSECURE_HTTP_ISSUER="true"

# PT sources
# SOURCE_PT_MAXPATROL_SIEM_BASE_URL=""
# SOURCE_PT_MAXPATROL_SIEM_INCIDENTS_BASE_URL=""
# SOURCE_PT_NAD_BASE_URL=""
# SOURCE_PT_NAD_STORE_IDS=""
# PT_NAD_HOST_IP=10.10.10.10
# PT_SIEM_HOST_IP=10.10.10.11
# The demo lab explicitly opts out because it uses a private CA.
# GATEWAY_SKIP_TLS_VERIFY="true"

# Wazuh Indexer (credentials belong to the project's JSON, never to ENV)
# SOURCE_WAZUH_BASE_URL="https://192.168.100.5:9201"
# SOURCE_WAZUH_INDEX_PATTERN="wazuh-alerts-*"
# SOURCE_WAZUH_TIMEOUT_SEC="10"
# SOURCE_WAZUH_TLS_CA_FILE=""
# SOURCE_WAZUH_SKIP_TLS_VERIFY="false"
# Optional keyword copy of the native _id, with doc_values and identical values.
# SOURCE_WAZUH_DOCUMENT_ID_FIELD="_id"
# If an outbound proxy is configured, include the private Indexer host in NO_PROXY.
